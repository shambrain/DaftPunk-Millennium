{
  "name": "Daft Punk Millennium",
  "author": "shambrain",
  "description": "An art-directed retro-futuristic Steam theme: mirrored chrome, visor-light window framing, and seven distinct era variants built on original CSS artwork. No album art, no official affiliation.",
  "version": "3.0.0",
  "header_image": "https://raw.githubusercontent.com/shambrain/DaftPunk-Millennium/main/assets/previews/library-discovery.png",
  "splash_image": "https://raw.githubusercontent.com/shambrain/DaftPunk-Millennium/main/assets/previews/game-details-tron.png",
  "tags": [
    "Daft Punk",
    "Retro-Futuristic",
    "Chrome",
    "Dark",
    "Customizable",
    "Animated",
    "Seven Eras"
  ],
  "github": {
    "owner": "shambrain",
    "repo_name": "DaftPunk-Millennium"
  },
  "Patches": [
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": "^OverlayBrowser_Browser$",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": "^SP Overlay:",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": "Supernav$",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": "^notificationtoasts_",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": "^SteamBrowser_Find$",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": "^OverlayTab\\d+_Find$",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": "^Steam Big Picture Mode$",
      "TargetCss": "bigpicture.custom.css"
    },
    {
      "MatchRegexString": "^QuickAccess_",
      "TargetCss": "bigpicture.custom.css"
    },
    {
      "MatchRegexString": "^MainMenu_",
      "TargetCss": "bigpicture.custom.css"
    },
    {
      "MatchRegexString": ".friendsui-container",
      "TargetCss": "friends.custom.css"
    },
    {
      "MatchRegexString": "Menu$",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": ".ModalDialogPopup",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": ".FullModalOverlay",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": "^https:\\/\\/store\\.steampowered\\.com\\/.*",
      "TargetCss": "webkit.css"
    },
    {
      "MatchRegexString": "^https:\\/\\/steamcommunity\\.com\\/.*",
      "TargetCss": "webkit.css"
    }
  ],
  "Conditions": {
    "Era": {
      "description": "Seven art directions built from the same chrome-and-light system. Each era changes material, geometry and motion, not just hue.",
      "default": "Discovery Era",
      "tab": "Era",
      "values": {
        "Discovery Era": {
          "TargetCss": { "affects": [".*"], "src": "themes/discovery-era.css" }
        },
        "Get Lucky Disco": {
          "TargetCss": { "affects": [".*"], "src": "themes/get-lucky-disco.css" }
        },
        "Cyan Visor": {
          "TargetCss": { "affects": [".*"], "src": "themes/cyan-visor.css" }
        },
        "Tron Legacy": {
          "TargetCss": { "affects": [".*"], "src": "themes/tron-legacy.css" }
        },
        "Neon Glow": {
          "TargetCss": { "affects": [".*"], "src": "themes/neon-glow.css" }
        },
        "Cosmic Voyager": {
          "TargetCss": { "affects": [".*"], "src": "themes/cosmic-voyager.css" }
        },
        "Classic Discovery": {
          "TargetCss": { "affects": [".*"], "src": "themes/classic-discovery.css" }
        }
      }
    },
    "Motion": {
      "description": "Controls the speed and amount of movement. Always respects the operating system reduced-motion setting.",
      "default": "Cinematic",
      "tab": "Motion",
      "values": {
        "Still": {
          "TargetCss": { "affects": [".*"], "src": "options/motion-still.css" }
        },
        "Subtle": {
          "TargetCss": { "affects": [".*"], "src": "options/motion-subtle.css" }
        },
        "Cinematic": {
          "TargetCss": { "affects": [".*"], "src": "options/motion-cinematic.css" }
        },
        "Overdrive": {
          "TargetCss": { "affects": [".*"], "src": "options/motion-overdrive.css" }
        }
      }
    },
    "Density": {
      "description": "Changes spacing, row height and panel padding across the library, game details and menus.",
      "default": "Standard",
      "tab": "Layout",
      "values": {
        "Compact": {
          "TargetCss": { "affects": [".*"], "src": "options/density-compact.css" }
        },
        "Standard": {
          "TargetCss": { "affects": [".*"], "src": "options/density-standard.css" }
        },
        "Spacious": {
          "TargetCss": { "affects": [".*"], "src": "options/density-spacious.css" }
        }
      }
    },
    "Visor Frame": {
      "description": "Draws the in-client chrome frame and visor light around the Steam window. This does not replace the native Windows titlebar.",
      "default": "yes",
      "tab": "Layout",
      "values": {
        "yes": {
          "TargetCss": { "affects": [".*"], "src": "options/frame-yes.css" }
        },
        "no": {
          "TargetCss": { "affects": [".*"], "src": "options/frame-no.css" }
        }
      }
    },
    "Typography": {
      "description": "Helmet Display uses the bundled Chakra Petch TTF files. System Clean falls back to Steam's own font stack.",
      "default": "Helmet Display",
      "tab": "Typography",
      "values": {
        "Helmet Display": {
          "TargetCss": { "affects": [".*"], "src": "options/type-helmet.css" }
        },
        "System Clean": {
          "TargetCss": { "affects": [".*"], "src": "options/type-system.css" }
        }
      }
    }
  }
}
